.TH "libnvme_ns_get_lba_count" 9 "libnvme_ns_get_lba_count" "October 2026" "libnvme API manual" LINUX
.SH NAME
libnvme_ns_get_lba_count \- Get lba_count.
.SH SYNOPSIS
.B "int" libnvme_ns_get_lba_count
.BI "(const struct libnvme_ns *p "  ","
.BI "uint64_t *lba_count "  ","
.BI "uint64_t dflt "  ");"
.SH ARGUMENTS
.IP "p" 12
The \fIstruct libnvme_ns\fP instance to query.
.IP "lba_count" 12
Where to store the value on success.
.IP "dflt" 12
Value to store in \fIlba_count\fP on failure.
.SH "RETURN"
0 on success, -ENOENT if the attribute does not
exist, or a negative errno on failure.
