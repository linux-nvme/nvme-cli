.TH "libnvmf_config_conn_get_subsysnqn" 9 "libnvmf_config_conn_get_subsysnqn" "October 2026" "libnvme API manual" LINUX
.SH NAME
libnvmf_config_conn_get_subsysnqn \- a connection's subsystem NQN.
.SH SYNOPSIS
.B "const char *" libnvmf_config_conn_get_subsysnqn
.BI "(const struct libnvmf_config_conn *conn "  ");"
.SH ARGUMENTS
.IP "conn" 12
the resolved connection
.SH "RETURN"
