.TH "libnvme" 9 "enum nvmf_treq" "October 2026" "API Manual" LINUX
.SH NAME
enum nvmf_treq \- Transport Requirements codes for Discovery Log Page entry TREQ field
.SH SYNOPSIS
enum nvmf_treq {
.br
.BI "    NVMF_TREQ_SECTYPE_SHIFT"
, 
.br
.br
.BI "    NVMF_TREQ_SECTYPE_MASK"
, 
.br
.br
.BI "    NVMF_TREQ_NOT_SPECIFIED"
, 
.br
.br
.BI "    NVMF_TREQ_REQUIRED"
, 
.br
.br
.BI "    NVMF_TREQ_NOT_REQUIRED"
, 
.br
.br
.BI "    NVMF_TREQ_DISABLE_SQFLOW_SHIFT"
, 
.br
.br
.BI "    NVMF_TREQ_DISABLE_SQFLOW_MASK"
, 
.br
.br
.BI "    NVMF_TREQ_DISABLE_SQFLOW"

};
.SH Constants
.IP "NVMF_TREQ_SECTYPE_SHIFT" 12
Shift amount to get Secure Channel requirement
.IP "NVMF_TREQ_SECTYPE_MASK" 12
Mask to get Secure Channel requirement
.IP "NVMF_TREQ_NOT_SPECIFIED" 12
Not specified
.IP "NVMF_TREQ_REQUIRED" 12
Required
.IP "NVMF_TREQ_NOT_REQUIRED" 12
Not Required
.IP "NVMF_TREQ_DISABLE_SQFLOW_SHIFT" 12
Shift amount to get SQ flow control disable
.IP "NVMF_TREQ_DISABLE_SQFLOW_MASK" 12
Mask to get SQ flow control disable
.IP "NVMF_TREQ_DISABLE_SQFLOW" 12
SQ flow control disable supported
