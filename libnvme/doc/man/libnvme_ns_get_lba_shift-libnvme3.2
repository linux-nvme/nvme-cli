.TH "libnvme_ns_get_lba_shift" 9 "libnvme_ns_get_lba_shift" "October 2026" "libnvme API manual" LINUX
.SH NAME
libnvme_ns_get_lba_shift \- Get lba_shift.
.SH SYNOPSIS
.B "int" libnvme_ns_get_lba_shift
.BI "(const struct libnvme_ns *p "  ","
.BI "int *lba_shift "  ","
.BI "int dflt "  ");"
.SH ARGUMENTS
.IP "p" 12
The \fIstruct libnvme_ns\fP instance to query.
.IP "lba_shift" 12
Where to store the value on success.
.IP "dflt" 12
Value to store in \fIlba_shift\fP on failure.
.SH "RETURN"
0 on success, -ENOENT if the attribute does not
exist, or a negative errno on failure.
