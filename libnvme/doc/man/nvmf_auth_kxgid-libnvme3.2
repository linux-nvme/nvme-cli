.TH "libnvme" 9 "enum nvmf_auth_kxgid" "October 2026" "API Manual" LINUX
.SH NAME
enum nvmf_auth_kxgid \- KX-HMAC-CHAP Key Exchange Group Identifiers
.SH SYNOPSIS
enum nvmf_auth_kxgid {
.br
.BI "    NVMF_AUTH_KXGID_NULL"
, 
.br
.br
.BI "    NVMF_AUTH_KXGID_FFDHE2048"
, 
.br
.br
.BI "    NVMF_AUTH_KXGID_FFDHE3072"
, 
.br
.br
.BI "    NVMF_AUTH_KXGID_FFDHE4096"
, 
.br
.br
.BI "    NVMF_AUTH_KXGID_FFDHE6144"
, 
.br
.br
.BI "    NVMF_AUTH_KXGID_FFDHE8192"
, 
.br
.br
.BI "    NVMF_AUTH_KXGID_SECP256R1"
, 
.br
.br
.BI "    NVMF_AUTH_KXGID_SECP384R1"
, 
.br
.br
.BI "    NVMF_AUTH_KXGID_MLKEM768"
, 
.br
.br
.BI "    NVMF_AUTH_KXGID_MLKEM1024"
, 
.br
.br
.BI "    NVMF_AUTH_KXGID_SECP256R1MLKEM768"
