.TH "libnvmf_config_conn_get_traddr" 9 "libnvmf_config_conn_get_traddr" "October 2026" "libnvme API manual" LINUX
.SH NAME
libnvmf_config_conn_get_traddr \- a connection's transport address.
.SH SYNOPSIS
.B "const char *" libnvmf_config_conn_get_traddr
.BI "(const struct libnvmf_config_conn *conn "  ");"
.SH ARGUMENTS
.IP "conn" 12
