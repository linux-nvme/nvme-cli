.TH "libnvme" 9 "struct nvme_lm_memory_range_tracking_descriptor" "October 2026" "API Manual" LINUX
.SH NAME
struct nvme_lm_memory_range_tracking_descriptor \- Memory Range Tracking Descriptor
.SH SYNOPSIS
struct nvme_lm_memory_range_tracking_descriptor {
.br
.BI "    __le64 saddr;"
.br
.BI "    __le32 len;"
.br
.BI "
};
.br

.SH Members
.IP "saddr" 12
Address (SADDR): starting host memory address of the range,
aligned to the granularity specified by \fIrmrtg\fP in \fIstruct
nvme_lm_track_memory_changes_data\fP
.IP "len" 12
Length (LEN), in units of the tracking granularity specified
by \fIrmrtg\fP
