.TH "libnvme" 9 "struct nvme_associate_ns_data" "October 2026" "API Manual" LINUX
.SH NAME
struct nvme_associate_ns_data \- Associate Namespace Data Structure
.SH SYNOPSIS
struct nvme_associate_ns_data {
.br
.BI "    __u8 pad[32];"
.br
.BI "    __le32 ensid;"
.br
.BI "    __u8 ensnqn[256];"
.br
.BI "    __le32 unsid;"
.br
.BI "    __le16 uctrlid;"
.br
.BI "    __u8 unsnqn[256];"
.br
.BI "    __u8 rsvd554[22];"
.br
.BI "
};
.br

.SH Members
.IP "pad" 12
Padding (PAD), shall be cleared to 0h
.IP "ensid" 12
Exported Namespace ID (ENSID) to associate
.IP "ensnqn" 12
Exported NVM Subsystem NQN (ENSNQN). Ignored for a
memory-based controller, or if ESUBIDV is set.
.IP "unsid" 12
Underlying Namespace ID (UNSID) to associate with \fIensid\fP
.IP "uctrlid" 12
Underlying Controller ID (UCTRLID). Ignored for a
memory-based controller.
.IP "unsnqn" 12
Underlying NVM Subsystem NQN (UNSNQN). Ignored for a
memory-based controller.
.IP "rsvd554" 12
Reserved
