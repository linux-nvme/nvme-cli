.TH "libnvme_subsystem_set_serial" 9 "libnvme_subsystem_set_serial" "October 2026" "libnvme API manual" LINUX
.SH NAME
libnvme_subsystem_set_serial \- Set serial.
.SH SYNOPSIS
.B "void" libnvme_subsystem_set_serial
.BI "(struct libnvme_subsystem *p "  ","
.BI "const char *serial "  ");"
.SH ARGUMENTS
.IP "p" 12
The \fIstruct libnvme_subsystem\fP instance to update.
.IP "serial" 12
New string; a copy is stored. Pass NULL to clear.
