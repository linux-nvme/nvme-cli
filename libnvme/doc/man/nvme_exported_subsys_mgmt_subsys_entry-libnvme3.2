.SH SYNOPSIS
struct nvme_exported_subsys_mgmt_subsys_entry {
.br
.BI "    __u8 rsvd0[24];"
.br
.BI "    __u8 subnqn[256];"
.br
.BI "    __le16 pidup;"
.br
.BI "    __u8 rsvd282[38];"
.br
.BI "
};
.br

.SH Members
.IP "rsvd0" 12
Reserved
.IP "subnqn" 12
NVM Subsystem NVMe Qualified Name (SUBNQN) of an Exported NVM
Subsystem
.IP "pidup" 12
Port ID of the Underlying Port (PIDUP)
