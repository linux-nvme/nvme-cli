struct nvmf_disc_log_entry {
.br
.BI "    __u8 trtype;"
.br
.BI "    __u8 adrfam;"
.br
.BI "    __u8 subtype;"
.br
.BI "    __u8 treq;"
.br
.BI "    __le16 portid;"
.br
.BI "    __le16 cntlid;"
.br
.BI "    __le16 asqsz;"
.br
.BI "    __le16 eflags;"
.br
