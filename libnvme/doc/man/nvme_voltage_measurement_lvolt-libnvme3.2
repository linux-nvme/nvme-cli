.SH SYNOPSIS
enum nvme_voltage_measurement_lvolt {
.br
.BI "    NVME_VOLTAGE_MEASUREMENT_LVOLT_LUVT_SHIFT"
, 
.br
.br
.BI "    NVME_VOLTAGE_MEASUREMENT_LVOLT_LUVT_MASK"
, 
.br
.br
.BI "    NVME_VOLTAGE_MEASUREMENT_LVOLT_LOVT_SHIFT"
, 
.br
.br
.BI "    NVME_VOLTAGE_MEASUREMENT_LVOLT_LOVT_MASK"

};
.SH Constants
.IP "NVME_VOLTAGE_MEASUREMENT_LVOLT_LUVT_SHIFT" 12
