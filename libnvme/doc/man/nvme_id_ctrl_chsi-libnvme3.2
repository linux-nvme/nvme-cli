.TH "libnvme" 9 "enum nvme_id_ctrl_chsi" "October 2026" "API Manual" LINUX
.SH NAME
enum nvme_id_ctrl_chsi \- CXL HDM Support Information
.SH SYNOPSIS
enum nvme_id_ctrl_chsi {
.br
.BI "    NVME_CTRL_CHSI_CHS_SHIFT"
, 
.br
.br
.BI "    NVME_CTRL_CHSI_CHS_MASK"

};
.SH Constants
.IP "NVME_CTRL_CHSI_CHS_SHIFT" 12
Shift amount to get the CXL HDM Support (CHS)
from the \fIstruct nvme_id_ctrl\fP.chsi field.
.IP "NVME_CTRL_CHSI_CHS_MASK" 12
Mask to get CHS
