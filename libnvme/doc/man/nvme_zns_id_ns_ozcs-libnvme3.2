enum nvme_zns_id_ns_ozcs {
.br
.BI "    NVME_ZNS_ID_NS_OZCS_RAZB_SHIFT"
, 
.br
.br
.BI "    NVME_ZNS_ID_NS_OZCS_RAZB_MASK"
, 
.br
.br
.BI "    NVME_ZNS_ID_NS_OZCS_ZRWASUP_SHIFT"
, 
.br
