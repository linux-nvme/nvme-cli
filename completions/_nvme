	# Describe options, giving those ending in '=' no trailing space.
	#
	# The tags are 'nvme-noeq-options'/'nvme-eq-options', deliberately NOT the
	# standard 'options' tag: when a device candidate is also offered (compadd
	# below), the completion system's handling of the reserved 'options' tag
	# suppressed the whole group at an empty prefix, so '--help' etc. only appeared
	# once a '-' was typed. A non-reserved tag sidesteps that.
	_nvme_describe() {
		local desc="$1"
		local -a opts=("${(@P)2}")
		local -a eq_opts noeq_opts
		local opt

		for opt in "${opts[@]}"; do
			if [[ "${opt%%:*}" == *= ]]; then
				eq_opts+=("$opt")
			else
				noeq_opts+=("$opt")
			fi
		done

		(( ${#noeq_opts} )) && _describe -t nvme-noeq-options "$desc" noeq_opts
		(( ${#eq_opts} )) && _describe -t nvme-eq-options "$desc" eq_opts -S ''
	}

	# Complete an option's value from a known set, in both the attached
