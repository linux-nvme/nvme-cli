	# space-separated spelling list ('--output-format -o'), VALUES its
	# space-separated value list. Completes the first option whose spelling matches
	# the word being entered.
	_nvme_opt_vals() {
		local -a names
		local name
		while (( $# >= 2 )); do
			names=(${=1})
			for name in "${names[@]}"; do
				if [[ ${words[CURRENT]} == ${name}=* ]] || \
				   [[ ${words[CURRENT-1]} == "${name}" ]]; then
					_values '' ${=2}
					return 0
				fi
			done
			shift 2
		done
		return 1
	}

	# Complete an option's value as a filename, in both the attached
	# ('--opt=path', '-o=path') and separate-word ('--opt path', '-o path') forms.
	# Each argument is a space-separated spelling list ('--fw -f'); if the word
	# being entered is that option's value, offer files. Mirrors the value form of
	# _nvme_opt_vals.
	_nvme_opt_files() {
		local -a names
		local name spec
		for spec in "$@"; do
			names=(${=spec})
			for name in "${names[@]}"; do
				if [[ ${words[CURRENT]} == ${name}=* ]]; then
					compset -P '*='
					_files
					return 0
				elif [[ ${words[CURRENT-1]} == "${name}" ]]; then
					_files
					return 0
				fi
			done
		done
		return 1
	}

