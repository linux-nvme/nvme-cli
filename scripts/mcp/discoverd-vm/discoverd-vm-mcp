"""MCP server which tests, in a VM, what a system shutdown does to the
nvme-discoverd connection units and the file systems mounted on them."""

import os
import shutil
import sys
from pathlib import Path

# The scenarios need tomllib, Python 3.11. Distributions with an older
# python3 may have newer ones as python3.N: run with the newest of them.
# This part has to run with the old one.
if sys.version_info < (3, 11):
    for minor in range(20, 10, -1):
        python = shutil.which('python3.%d' % minor)
        if python:
            os.execv(python, [python, *sys.argv])
    sys.exit('discoverd-vm-mcp needs Python 3.11 or newer')

sys.path.insert(0, str(Path(__file__).resolve().parent))

from dvm_mcp.cli import main

sys.exit(main())
