# SPDX-License-Identifier: GPL-2.0-or-later
[Unit]
Description=NVMe-oF Discovery Daemon
Documentation=man:nvme-discoverd(8)
Before=remote-fs.target
After=nvme-keysd.service
# A TLS connection fails at once if tlshd is not running.
After=tlshd.service
@DISCOVERD_AFTER_RESOLVED@

[Service]
Type=notify-reload
# Mask the legacy autoconnect rule while nvme-discoverd runs: both would
# connect on the same events. A rule in /run overrides the one in
# /usr/lib, including one left over from an older installation. The
# daemon starts even if masking fails.
ExecStartPre=-mkdir -p /run/udev/rules.d
ExecStartPre=-ln -sfn /dev/null /run/udev/rules.d/70-nvmf-autoconnect.rules
ExecStartPre=-udevadm control --reload
ExecStart=@SBINDIR@/nvme-discoverd
ExecStopPost=-rm -f /run/udev/rules.d/70-nvmf-autoconnect.rules
ExecStopPost=-udevadm control --reload
Restart=on-failure
RuntimeDirectory=nvme/discoverd nvme/discoverd/units nvme/discoverd/controllers
RuntimeDirectoryPreserve=yes

[Install]
WantedBy=multi-user.target
