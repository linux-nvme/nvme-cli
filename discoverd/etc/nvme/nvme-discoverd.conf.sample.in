# Example nvme-discoverd configuration.
#
# This file is NOT read by nvme-discoverd -- it is a reference only. To
# change a setting, copy it to @SYSCONFDIR@/nvme/nvme-discoverd.conf and
# edit the copy.
#
# All options are optional and have the defaults shown below.
# Connections managed by nvme-discoverd are configured in the shared
# NVMe-oF fabrics configuration (nvme-fabrics.conf(5)).
#
# Boolean values: yes/no, true/false, 1/0, on/off (case-insensitive).

# ==============================================================================
[Global]

# Keep the connections of the pre-OS environment (firmware and initrd)
# connected: the controllers listed in the NBFT ACPI table and in
# @RUNDIR@/nvme/pre-os.conf, which nvme writes in the initrd. They keep
# the owner pre-os: nvme-discoverd reconnects them with the parameters the
# pre-OS environment used, never disconnects them, and the exclusion list
# does not apply to them. "nbft" is the old name of this key.
#pre-os = true

# Log verbosity: err, warn, info, or debug (case-insensitive).
# The --debug command-line option overrides this setting and enables debug
# logging.
#debug-level = info

# ==============================================================================
[Discovery]

# Settings for dynamically discovered Discovery Controllers.

# How often, in minutes, to reconnect and check a Discovery Controller whose
# effective EPCSD (Explicit Persistent Connection Support for Discovery) value
# is 0. Such controllers are disconnected between checks.
# Must be at least 1.
#epcsd-poll-interval-minutes = 15

# FC kickstart interval, in minutes.
# 0 = kickstart only at startup and when an FC controller is disconnected.
# N (N >= 1) = additionally kickstart every N minutes.
#fc-kickstart-interval-minutes = 0

# How long to retry a failed connection to a Discovery Controller found only
# through mDNS or FC kickstart before giving up and removing it from
# tracking. Does not apply to controllers from NBFT, the fabrics
# configuration or a referral: those retry forever.
#
# Accepts a systemd time span (e.g. "72hours" or "3 days 5 hours") or a
# value in seconds without a unit.
# "infinity" = never give up.
# 0 = give up after the first failure.
#dc-giveup-timeout = 72hours

# Failed attempts after which an I/O controller whose Discovery Log Page entry
# has NCC (No CDC Connectivity) set is no longer tried. It is tried again when
# the entry no longer has NCC set. Does not apply to controllers from NBFT or
# the fabrics configuration.
# 0 = no limit.
#connect-attempts-on-ncc = 0

# Connect to and manage Discovery Controllers found through mDNS (TP8009).
# Disabled by default.
#zeroconf = false
