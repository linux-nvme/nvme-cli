#
# The commands of the controller registers. plugins/meson.build always
# builds this plugin.

plugin_extension = false

plugin_sources += [
    'plugins/cmds-regs/cmds-regs-plugin.c',
]

plugin_commands = [
    'show-regs',
    'set-reg',
    'get-reg',
    'set-property',
    'get-property',
]
