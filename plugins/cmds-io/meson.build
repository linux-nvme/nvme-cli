#
# The I/O commands. plugins/meson.build always builds this plugin.

plugin_extension = false

plugin_sources += [
    'plugins/cmds-io/cmds-io-plugin.c',
]

plugin_commands = [
    'dsm',
    'copy',
    'flush',
    'compare',
    'read',
    'write',
    'write-zeroes',
    'write-uncor',
    'verify',
    'get-lba-status',
    'capacity-mgmt',
]
